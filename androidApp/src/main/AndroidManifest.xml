<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="com.android.vending.BILLING" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".android.RastroApplication"
        android:allowBackup="false"
        android:icon="@drawable/rastro_logo_base"
        android:label="RASTRO"
        android:roundIcon="@drawable/rastro_logo_base"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rastro">
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="${admobAppId}" />

        <activity
            android:name=".android.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>

            <!-- App Links: abre enlaces de rumbo-jonsu.web.app directo en la app nativa -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="rumbo-jonsu.web.app" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.pizarra.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/pizarra_file_paths" />
        </provider>

        <receiver android:name=".android.pomodoro.PomodoroAlarmReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- Dynamic Launcher Aliases -->
        <activity-alias
            android:name=".android.MainActivityBase"
            android:targetActivity=".android.MainActivity"
            android:icon="@drawable/rastro_logo_base"
            android:roundIcon="@drawable/rastro_logo_base"
            android:label="RASTRO"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/rastro_shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".android.MainActivityEnojo"
            android:targetActivity=".android.MainActivity"
            android:icon="@drawable/rastro_logo_enojo"
            android:roundIcon="@drawable/rastro_logo_enojo"
            android:label="RASTRO"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/rastro_shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".android.MainActivityFuria"
            android:targetActivity=".android.MainActivity"
            android:icon="@drawable/rastro_logo_furia"
            android:roundIcon="@drawable/rastro_logo_furia"
            android:label="RASTRO"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/rastro_shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".android.MainActivityTriste"
            android:targetActivity=".android.MainActivity"
            android:icon="@drawable/rastro_logo_triste"
            android:roundIcon="@drawable/rastro_logo_triste"
            android:label="RASTRO"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/rastro_shortcuts" />
        </activity-alias>

        <!-- Widgets de RASTRO -->
        <receiver
            android:name=".android.widgets.RachaWidgetProvider"
            android:label="@string/widget_daily_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/racha_widget_info" />
        </receiver>

        <receiver
            android:name=".android.widgets.RachaSemanalWidgetProvider"
            android:label="@string/widget_weekly_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/racha_semanal_widget_info" />
        </receiver>

        <receiver
            android:name=".android.widgets.ExamCountdownWidgetProvider"
            android:label="@string/widget_countdown_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/exam_countdown_widget_info" />
        </receiver>

        <receiver
            android:name=".android.widgets.MotivacionWidgetProvider"
            android:label="@string/widget_quote_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/motivacion_widget_info" />
        </receiver>

    </application>

</manifest>
