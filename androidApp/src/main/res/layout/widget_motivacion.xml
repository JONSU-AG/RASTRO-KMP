<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_motivacion_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_bg_frase" android:scaleType="fitCenter" android:contentDescription="@string/app_name" android:id="@+id/widget_artwork" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:paddingLeft="56dp" android:paddingRight="56dp" android:paddingTop="12dp" android:paddingBottom="6dp" android:id="@+id/widget_data_overlay">
        <TextView android:id="@+id/widget_motivacion_quote" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:text="La disciplina vence al talento cuando el talento no se esfuerza." android:textColor="#0F172A" android:textSize="13sp" android:textStyle="italic" android:maxLines="4" android:ellipsize="end" />
        <TextView android:id="@+id/widget_motivacion_author" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:text="— RASTRO" android:textColor="#64748B" android:textSize="10sp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>
</FrameLayout>
