<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_motivacion_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_background"
    android:gravity="center"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✨ MENSAJE DEL DÍA"
        android:textColor="#D97706"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_motivacion_quote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="&quot;Cada problema resuelto hoy es un punto más en tu examen de admisión.&quot;"
        android:textColor="#0F172A"
        android:textSize="12sp"
        android:textStyle="italic" />

    <TextView
        android:id="@+id/widget_motivacion_author"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="— Orstty &amp; Artyon (RASTRO)"
        android:textColor="#64748B"
        android:textSize="9.5sp"
        android:textStyle="bold" />

</LinearLayout>
