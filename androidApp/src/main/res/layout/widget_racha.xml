<?xml version="1.0" encoding="utf-8"?>
<!-- Racha diaria 2x1 FINAL: sin layout_weight (rompía el launcher).
     PNG fijo + pastilla crema a la derecha con gravedad y ancho fijo. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_racha_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_bg_racha_diaria"
        android:scaleType="centerCrop"
        android:contentDescription="@string/app_name" />

    <LinearLayout
        android:layout_width="92dp"
        android:layout_height="wrap_content"
        android:layout_gravity="right|center_vertical"
        android:layout_marginRight="8dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_pill_background"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_racha_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9"
                android:textColor="#0F172A"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_racha_fire"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="🔥"
                android:textSize="26sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_racha_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DÍAS DE RACHA"
            android:textColor="#0F172A"
            android:textSize="8sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1" />

    </LinearLayout>

</FrameLayout>
