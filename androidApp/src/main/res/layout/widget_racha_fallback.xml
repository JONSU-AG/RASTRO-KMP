<?xml version="1.0" encoding="utf-8"?>
<!-- Layout mínimo de diagnóstico: si este widget sí se agrega, el problema está
     en el layout completo (imagen/fondos); si tampoco, es del sistema/launcher. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_racha_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#FFFFF8EC"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔥 RASTRO"
        android:textColor="#0F172A"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_racha_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="8"
        android:textColor="#EA580C"
        android:textSize="32sp"
        android:textStyle="bold" />

</LinearLayout>
