rules_version = '2';
// RASTRO · Reglas Firestore — mínimo privilegio.
// El administrador se verifica por correo del autor (viene firmado en el token de Auth,
// no se puede falsificar desde la app).
// ⚠️ ANTES DE PUBLICAR: pruébala en Firebase Console > Firestore > Reglas > Simulador,
// luego despliega SOLO reglas con: firebase deploy --only firestore:rules --project rumbo-jonsu
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function author() {
      return signedIn() && request.auth.token.email_verified == true && request.auth.token.email in [
        'aguilar.jonsu@gmail.com',
        'rumbo.jonsu@gmail.com',
        'jhojan.aguilar.13.10@gmail.com',
        'rulua617@gmail.com',
        '147279812+rulua617@users.noreply.github.com'
      ];
    }

    // Campos que NADIE salvo el autor puede crear ni modificar
    function privKeys() {
      return ['role', 'isAdmin', 'isCreator', 'isAlly', 'banned',
              'hasWarning', 'warningDismissed', 'warningMessage', 'banReason'];
    }

    // Dueño del documento (compatible con los distintos formatos que usa la app)
    function ownsDoc() {
      return signedIn() && (
        resource.data.get('authorUid', '') == request.auth.uid ||
        resource.data.get('ownerId', '') == request.auth.uid ||
        resource.data.get('uid', '') == request.auth.uid ||
        resource.data.get('senderUid', '') == request.auth.uid ||
        resource.data.get('followerUid', '') == request.auth.uid ||
        resource.data.get('recipientUid', '') == request.auth.uid ||
        (resource.data.get('uploadedBy', {}) is map &&
         resource.data.uploadedBy.get('uid', '') == request.auth.uid)
      );
    }

    function createsOwnContent() {
      return signedIn() && request.resource.data.get('authorUid', '') == request.auth.uid;
    }

    function preservesOwnership() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['authorUid', 'ownerId', 'uploadedBy', 'uid', 'senderUid', 'recipientUid', 'followerUid']);
    }

    function preservesModeration() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['oculto', 'hidden', 'autoModerated', 'moderationReason']);
    }

    function canAutoHide() {
      return request.resource.data.get('oculto', false) == true
        && request.resource.data.get('hidden', false) == true
        && request.resource.data.get('reportsCount', 0) == resource.data.get('reportsCount', 0) + 1
        && request.resource.data.get('reportsCount', 0) >= 3
        && request.auth.uid in request.resource.data.get('reportedBy', [])
        && request.resource.data.get('autoModerated', false) == resource.data.get('autoModerated', false)
        && request.resource.data.get('moderationReason', '') == resource.data.get('moderationReason', '');
    }

    // —— Perfiles: públicos para leer, cada uno edita solo el suyo sin tocar privilegios ——
    match /usuarios/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(privKeys());
      allow update: if signedIn() && (
        (request.auth.uid == uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(privKeys())) ||
        author()
      );
      allow delete: if (signedIn() && request.auth.uid == uid) || author();
    }

    // —— Contenido editorial (cursos, academias, oficiales, temarios): lectura pública, escritura del autor ——
    match /cursos/{d} { allow read: if true; allow write: if author(); }
    match /academias/{d} { allow read: if true; allow write: if author(); }
    match /oficiales/{d} { allow read: if true; allow write: if author(); }
    match /briceno_2027_semanas/{d} { allow read: if true; allow write: if author(); }
    match /foro_preguntas/{d} { allow read: if true; allow write: if author(); }

    // —— Contenido de la comunidad: lectura pública, crear con sesión, editar/borrar dueño o autor ——
    match /uploads/{d} {
      allow read: if true;
      allow create: if author() || (signedIn()
        && request.resource.data.get('ownerId', '') == request.auth.uid
        && request.resource.data.get('uploadedBy', {}).get('uid', '') == request.auth.uid);
      allow delete: if ownsDoc() || author();
      allow update: if author() || (ownsDoc() && preservesOwnership() && preservesModeration()) || (
        signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'savedBy', 'likedBy', 'reportedBy', 'reportsCount', 'oculto', 'hidden', 'autoModerated', 'moderationReason', 'reactions'
        ]) && (preservesModeration() || canAutoHide())
      );
    }
    match /libros/{d} {
      allow read: if true;
      allow create: if createsOwnContent() || author();
      allow update: if author() || (ownsDoc() && preservesOwnership());
      allow delete: if ownsDoc() || author();
    }
    match /flashcards/{d} {
      allow read: if true;
      allow create: if createsOwnContent() || author();
      allow update: if author() || (ownsDoc() && preservesOwnership());
      allow delete: if ownsDoc() || author();
    }
    match /preguntas_examen/{d} {
      allow read: if true;
      allow create: if createsOwnContent() || author();
      allow update: if author() || (ownsDoc() && preservesOwnership());
      allow delete: if ownsDoc() || author();
    }
    match /perfil_comentarios/{d} {
      allow read: if true;
      allow create: if createsOwnContent() || author();
      allow update: if author() || (ownsDoc() && preservesOwnership());
      allow delete: if ownsDoc() || author();
    }
    match /publicacion_comentarios/{d} {
      allow read: if true;
      allow create: if createsOwnContent() || author();
      allow update: if author() || (ownsDoc() && preservesOwnership());
      allow delete: if ownsDoc() || author();
    }
    match /clase_comentarios/{d} {
      allow read: if true;
      allow create: if createsOwnContent() || author();
      allow update: if author() || (ownsDoc() && preservesOwnership());
      allow delete: if ownsDoc() || author();
    }

    // —— Notificaciones: solo el destinatario las lee; el remitente las crea ——
    match /notificaciones/{d} {
      allow read: if signedIn() && (
        resource.data.get('recipientUid', '') == request.auth.uid ||
        resource.data.get('recipientUid', '') == 'all' || author()
      );
      allow create: if signedIn() &&
        request.resource.data.get('senderUid', '') == request.auth.uid;
      allow update, delete: if author() || (signedIn() &&
        resource.data.get('recipientUid', '') == request.auth.uid);
    }

    // —— Mensajes directos: solo participantes ——
    match /mensajes_directos_privados/{d} {
      allow read: if signedIn() && (
        resource.data.get('senderUid', '') == request.auth.uid ||
        resource.data.get('recipientUid', '') == request.auth.uid || author()
      );
      allow create: if signedIn() &&
        request.resource.data.get('senderUid', '') == request.auth.uid;
      allow update, delete: if ownsDoc() || author();
    }

    // —— Seguidos: lectura pública (se muestra en perfiles), alta/baja del propio seguidor ——
    match /siguiendo/{d} {
      allow read: if true;
      allow create: if signedIn() &&
        request.resource.data.get('followerUid', '') == request.auth.uid;
      allow delete: if ownsDoc() || author();
      allow update: if author();
    }

    // —— Ranking: lectura pública, cada uno registra su propio puntaje ——
    match /ranking_simulacros/{d} {
      allow read: if true;
      allow create: if author() || (signedIn() && request.resource.data.get('uid', '') == request.auth.uid);
      allow update: if author() || (ownsDoc() && preservesOwnership());
      allow delete: if ownsDoc() || author();
    }

    // —— Reportes y solicitudes: crear con sesión, gestionar solo el autor ——
    match /reportes/{d} {
      allow create: if signedIn() && request.resource.data.get('reporterUid', '') == request.auth.uid;
      allow read, update, delete: if author();
    }
    match /reportes_ugc/{d} {
      allow create: if signedIn() && request.resource.data.get('reporterUid', '') == request.auth.uid;
      allow read, update, delete: if author();
    }
    match /solicitudes_aliados/{d} {
      allow create: if signedIn() && request.resource.data.get('uid', '') == request.auth.uid;
      allow read: if author() || (signedIn() &&
        resource.data.get('uid', '') == request.auth.uid);
      allow update, delete: if author();
    }

    // —— Progreso de gamificación: cada usuario sincroniza solo el suyo ——
    match /usuarios/{uid}/gamificacion/{d} {
      allow read, write: if (signedIn() && request.auth.uid == uid) || author();
    }

    // —— Configuración del sitio (switches, ocultos, banners): lectura pública, escritura del autor ——
    match /system_config/{d} {
      allow read: if true;
      allow write: if author();
    }
    match /site_settings/{d} {
      allow read: if true;
      allow write: if author();
    }

    // —— Playlists YouTube por cuenta (nuevo, aislado): privado por defecto, público solo si isShared ——
    // PROPUESTA sin desplegar: requiere deploy manual con permiso explícito.
    match /rastro_yt_playlists/{d} {
      allow create: if signedIn()
        && request.resource.data.get('ownerUid', '') == request.auth.uid
        && request.resource.data.get('isShared', false) == false
        && request.resource.data.get('isCurated', false) == false
        && request.resource.data.get('isHidden', false) == false;
      allow read: if resource.data.get('isHidden', false) == false && (
        (resource.data.get('isShared', false) == true) ||
        (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid) ||
        author()
      );
      allow update: if author() || (signedIn()
        && resource.data.get('ownerUid', '') == request.auth.uid
        && request.resource.data.get('ownerUid', '') == request.auth.uid
        && request.resource.data.get('isCurated', false) == resource.data.get('isCurated', false)
        && request.resource.data.get('isHidden', false) == resource.data.get('isHidden', false));
      allow delete: if (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid) || author();
    }

    // Amistad/racha compartida: leer solo como participante y aceptar solo como destinatario.
    match /racha_dual/{d} {
      function member() { return signedIn() && (request.auth.uid in resource.data.get('participants', [])
        || resource.data.user1Uid == request.auth.uid || resource.data.user2Uid == request.auth.uid); }
      function ownDailyUpdate() {
        return member() && resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dailyActivity'])
          && request.resource.data.dailyActivity.diff(resource.data.get('dailyActivity', {})).affectedKeys().hasOnly([request.auth.uid]);
      }
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/racha_dual/$(d)) ||
        resource.data.user1Uid == request.auth.uid || resource.data.user2Uid == request.auth.uid || member());
      allow list: if signedIn() &&
        (resource.data.user1Uid == request.auth.uid || resource.data.user2Uid == request.auth.uid || member());
      allow create: if signedIn() && request.resource.data.get('type', '') == 'group'
        && request.resource.data.user1Uid == request.auth.uid
        && request.resource.data.participants is list && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 10
        && request.resource.data.participants.size() == request.resource.data.participants.toSet().size()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.user2Uid in request.resource.data.participants && request.resource.data.user2Uid != request.auth.uid
        && request.resource.data.accepted.keys().hasOnly([request.auth.uid])
        && request.resource.data.accepted.get(request.auth.uid, false) == true
        && request.resource.data.dailyActivity == {} && request.resource.data.status == 'pending'
        && request.resource.data.streakDays == 0;
      allow create: if signedIn() && request.resource.data.get('type', '') != 'group' && request.resource.data.user1Uid == request.auth.uid
        && request.resource.data.user2Uid is string && request.resource.data.user2Uid != request.auth.uid
        && request.resource.data.status == 'pending' && request.resource.data.streakDays == 0
        && request.resource.data.participants == [request.resource.data.user1Uid, request.resource.data.user2Uid]
        && (d == request.resource.data.user1Uid + '_' + request.resource.data.user2Uid ||
            d == request.resource.data.user2Uid + '_' + request.resource.data.user1Uid);
      allow update: if ownDailyUpdate();
      allow update: if signedIn() && resource.data.get('type', '') != 'group' && resource.data.status == 'rejected'
        && request.auth.uid in [resource.data.user1Uid, resource.data.user2Uid]
        && request.resource.data.user1Uid == request.auth.uid
        && request.resource.data.user2Uid in [resource.data.user1Uid, resource.data.user2Uid]
        && request.resource.data.user2Uid != request.auth.uid
        && request.resource.data.status == 'pending' && request.resource.data.streakDays == 0
        && request.resource.data.participants == [request.resource.data.user1Uid, request.resource.data.user2Uid]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['id', 'user1Uid', 'user2Uid', 'status', 'streakDays', 'senderName', 'recipientName', 'participants', 'updatedAt']);
      allow update: if member() && resource.data.get('type', '') == 'group' && resource.data.status == 'pending'
        && resource.data.get('accepted', {}).get(request.auth.uid, false) != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accepted', 'status'])
        && request.resource.data.accepted.diff(resource.data.accepted).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.accepted.get(request.auth.uid, null) is bool
        && ((request.resource.data.accepted[request.auth.uid] == false && request.resource.data.status == 'rejected')
          || (request.resource.data.accepted[request.auth.uid] == true
            && ((request.resource.data.accepted.keys().hasAll(resource.data.participants)
                 && request.resource.data.accepted.values().hasOnly([true]) && request.resource.data.status == 'active')
              || (request.resource.data.status == 'pending' && !request.resource.data.accepted.keys().hasAll(resource.data.participants)))));
      allow update: if signedIn() && resource.data.user2Uid == request.auth.uid && resource.data.get('type', '') != 'group'
        && resource.data.status == 'pending' && request.resource.data.status in ['active', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['status', 'senderName', 'recipientName', 'participants', 'updatedAt'])
        && request.resource.data.participants == [resource.data.user1Uid, resource.data.user2Uid];
    }

    // —— Todo lo demás: denegado por defecto ——
    match /{document=**} {
      allow read, write: if author();
    }
  }
}
